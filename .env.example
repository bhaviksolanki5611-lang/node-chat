NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Number of reverse-proxy hops in front of the app (set 1 behind a load balancer)
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173

# Auth (>= 32 chars). Swap verifyAccessToken() for your IdP in production.
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
JWT_ISSUER=chat-backend

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=chat_app
MYSQL_POOL_SIZE=20

# Required when running more than one instance (shared cache + rate limits)
REDIS_URL=redis://127.0.0.1:6379

# Firebase: service account OR emulator
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-chat

RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_SEND_PER_MIN=60
